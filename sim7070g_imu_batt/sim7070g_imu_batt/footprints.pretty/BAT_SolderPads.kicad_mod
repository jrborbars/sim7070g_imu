(footprint "BAT_SolderPads"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Solder pads for a 1S LiPo pack (no JST): two 4.0x3.0mm tinned pads, 6mm apart, plus two 1.0mm NPTH strain-relief holes so the flying leads can be lashed and the solder joint never takes the pull load. Pad 1 = BAT+, pad 2 = BAT-. Silk marks polarity. Keep the pad pair away from the module VBAT pins so the 1000mAh pack leads stay short.")
	(tags "battery lipo solder pad wire battery-1s strain relief")
